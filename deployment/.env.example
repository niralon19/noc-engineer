# REQUIRES FROM NIR: A2, B2, D1, D2, D3, H1 (docs/OPEN-QUESTIONS.md). Before implementing/filling run `python3 scripts/open_items.py --file deployment/.env.example`; if BLOCKED, ask Nir. Never invent.
# Secrets live here, never in skills.
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
PROMETHEUS_URL=
THANOS_URL=
GRAFANA_URL=
GRAFANA_TOKEN=

# Optional services (docker compose --profile optional)
POSTGRES_DB=noc_engineer
POSTGRES_USER=noc_engineer
POSTGRES_PASSWORD=change-me
NOC_TIMEZONE=Asia/Jerusalem
NOC_RETENTION_DAYS=365
HERMES_CONFIG_PATH=/path/to/hermes/profile/config.yaml

# ===== Required by Hermes =====
# Shared secret Hermes sends to noc-mcp (same value in the noc-mcp Secret)
NOC_MCP_TOKEN=change-me-long-random
# Model key for the custom OpenAI-compatible provider (base_url/model live in config.yaml)
OPENAI_API_KEY=
# API server (web app / Open WebUI). Required for every deployment.
API_SERVER_ENABLED=true
API_SERVER_KEY=change-me-long-random
# API_SERVER_CORS_ORIGINS=   # leave empty: the app calls Hermes server-to-server
# Slack gateway (Socket Mode: outbound only, no public URL)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_ALLOWED_USERS=          # comma-separated Slack member IDs of the team (empty = nobody)
SLACK_HOME_CHANNEL=           # channel ID for cron output (on-call report, proactive review)
SLACK_HOME_CHANNEL_NAME=
# ECK / Elasticsearch
ECK_URL=
ECK_USER=
ECK_PASSWORD=
# Kafka
KAFKA_BOOTSTRAP=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
# Argo CD (read-only token)
ARGOCD_URL=
ARGOCD_TOKEN=
# Kubernetes (read-only service accounts)
RANCHER_KUBECONFIG=
OPENSHIFT_KUBECONFIG=
# Rule & configuration management system (read-only)
RULES_API_URL=
RULES_API_TOKEN=
# Investigation history (existing org Postgres, dedicated schema)
HISTORY_DATABASE_URL=
