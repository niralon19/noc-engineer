# Secrets live here, never in skills.
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
PROMETHEUS_URL=
THANOS_URL=
GRAFANA_URL=
GRAFANA_TOKEN=

# Optional services (docker compose --profile optional)
POSTGRES_DB=noc_engineer
POSTGRES_USER=noc_engineer
POSTGRES_PASSWORD=change-me
NOC_TIMEZONE=Asia/Jerusalem
NOC_RETENTION_DAYS=365
HERMES_CONFIG_PATH=/path/to/hermes/profile/config.yaml

# Kimi K3 (OpenAI-compatible endpoint) - used by Hermes provider config
KIMI_BASE_URL=
KIMI_API_KEY=
# ECK / Elasticsearch
ECK_URL=
ECK_USER=
ECK_PASSWORD=
# Kafka
KAFKA_BOOTSTRAP=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
# Argo CD (read-only token)
ARGOCD_URL=
ARGOCD_TOKEN=
# Kubernetes (read-only service accounts)
RANCHER_KUBECONFIG=
OPENSHIFT_KUBECONFIG=
# Rule & configuration management system (read-only)
RULES_API_URL=
RULES_API_TOKEN=
# Investigation history (existing org Postgres, dedicated schema)
HISTORY_DATABASE_URL=
