# Secrets live here, never in skills.
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
PROMETHEUS_URL=
THANOS_URL=
GRAFANA_URL=
GRAFANA_TOKEN=
LOKI_URL=

# Optional services (docker compose --profile optional)
POSTGRES_DB=noc_engineer
POSTGRES_USER=noc_engineer
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=noc_engineer
RABBITMQ_PASSWORD=change-me
