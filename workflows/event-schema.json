{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOC Event",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "source", "severity", "entity"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["anomaly.detected", "jira.issue.created", "jira.issue.updated", "telemetry.quality_failed"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "severity": {"enum": ["info", "warning", "critical"]},
    "entity": {"type": "string"},
    "correlation_id": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
