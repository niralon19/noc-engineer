{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOC Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "severity",
    "entity",
    "kind",
    "fingerprint"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "grafana.alert.firing",
        "grafana.alert.resolved",
        "anomaly.detected",
        "jira.issue.created",
        "jira.issue.updated",
        "telemetry.quality_failed",
        "config.change.requested",
        "config.change.applied"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "entity": {
      "type": "string"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "kind": {
      "enum": [
        "hermeticity",
        "coupling",
        "loss",
        "load",
        "app",
        "infra",
        "config",
        "other"
      ]
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "hop": {
      "type": [
        "string",
        "null"
      ],
      "description": "hop id from noc-mcp/config/pipeline.yaml"
    },
    "scope": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cluster": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
