# Copy to $HERMES_HOME/.env (k8s: Secret hermes-noc-env). Never commit real values.
OPENAI_API_KEY=                 # key for the Kimi endpoint in config.yaml

# Slack gateway (Socket Mode, outbound only)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=            # member IDs allowed to talk to the agent (team + allowed customers)
SLACK_HOME_CHANNEL=             # team channel: cron output (anomalies, 09:00 summary, Grafana/Jira results)

PROMETHEUS_URL=
PROMETHEUS_TOKEN=
ECK_URL=
ECK_USER=
ECK_PASSWORD=
GRAFANA_URL=
GRAFANA_TOKEN=
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
NOC_JIRA_ALLOW_COMMENT=false    # true = the agent may comment on customer tickets (only write it can do)
